<% layout('layouts/boilerplate.ejs') %>
<br />
<br />

<div class="row">
  <div class="col-5 offset-3">
    <h2 class="mb-4">Add Your Journey</h2>
    <form
      method="POST"
      action="/listings"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label
          for="title"
          class="form-label"
          for="validationCustom01"
          class="form-label"
          >Title</label
        ><br />
        <input
          class="form-control"
          name="listing[title]"
          placeholder="Give your Journey title"
          type="text"
          required
        />
        <div class="invalid-feedback">Enter valid Name!</div>
      </div>

<!-- Description -->
      <div class="mb-3">
        <label for="description" class="form-label">Description </label><br />
        <textarea
          class="form-control"
          name="listing[description]"
          placeholder="Share some detail about your place"
          rows="3"
          required
        ></textarea>
        <div class="invalid-feedback">Description About Place!</div>
      </div>
      <div class="mb-3">
        <label for="image" class="form-label">Upload Listing Image </label
        ><br />
        <input class="form-control" name="listing[image]" type="file" required/>
      </div>

<!-- Price -->
      <div class="row">
        <div class="mb-3 col-md-5">
          <label for="price" class="form-label">Price</label><br />
          <input
            name="listing[price]"
            placeholder="1500"
            class="form-control"
            required
          />
        </div>

    <!-- Country -->
        <div class="mb-3 col-md-7">
          <label for="country" class="form-label">Country </label><br />
          <input
            class="form-control"
            name="listing[country]"
            placeholder="India"
            type="text"
            required
          />
          <div class="invalid-feedback">
            Please provide a valid Country/City.
          </div>
        </div>
      </div>

   <!-- Location -->
      <div class="mb-3">
        <label class="form-label">Location </label><br />
        <input
          class="form-control"
          name="listing[location]"
          placeholder="Goa,Singapore"
          type="text"
          required
        />
      </div>


        
  <!-- Drop Down Menu -->

  <select class="form-select mb-3"  name="listing[category]">
    <option value="" selected disabled>Select an Action</option>
    <option value="Mountain">Mountain</option>
    <option value="Mountain-city">Mountain-city</option>
    <option value="Beach">Beach</option>
    <option value="Rooms">Rooms</option>
    <option value="Cafe">Cafe</option>
    <option value="Farms">Farms</option>
    <option value="Trending">Trending</option>
    <option value="Castles">Castles</option>
    <option value="Hiking">Hiking</option>
    <option value="Restaurants">Restaurants</option>
    <option value="Forest">Forest</option>
  </select>


      <br /><br />
      <button class="btn btn-secondary">Add New Listing</button>
    </form>
    <br /><br />
  </div>
</div>
