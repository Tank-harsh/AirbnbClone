<% layout('layouts/boilerplate.ejs') %>



  <!-- <div class="mt-3"> -->
  <div id="filters">
    <button class="filter"
    data-filter="Mountain"> <i class="fa-solid fa-mountain"></i>
      <p>Mountain</p>
    </button>
    <button class="filter"
    data-filter="Mountain-city"> <i class="fa-solid fa-mountain-city"></i>
      <p>Mountain-city</p>
    </button>
    <button class="filter"
    data-filter="Beach"> <i class="fa-solid fa-umbrella-beach"></i>
      <p>Beach</p>
    </button>
    <button class="filter"
    data-filter="Rooms"> <i class="fa-solid fa-bed"></i>
      <p>Rooms</p>
    </button>
    <button class="filter"
    data-filter="Cafe"> <i class="fa-solid fa-mug-saucer"></i>
      <p>Cafe</p>
    </button>
    <button class="filter"
    data-filter="Farms"> <i class="fa-solid fa-tractor"></i>
      <p>Farms</p>
    </button>
    <button class="filter"
    data-filter="Trending"> <i class="fa-solid fa-fire"></i>
      <p>Trending</p>
    </button>
    <button class="filter"
    data-filter="Castles"> <i class="fa-brands fa-fort-awesome"></i>
      <p>Castles</p>
    </button>
    <button class="filter"
    data-filter="Hiking"> <i class="fa-solid fa-person-hiking"></i>
      <p>Hiking</p>
    </button>
    <button class="filter"
    data-filter="Restaurants"> <i class="fa-solid fa-utensils"></i>
      <p> Restaurants</p>
    </button>
     <button class="filter"
     data-filter="Forest"> <i class="fa-solid fa-tree"></i>
      <p> Forest</p>
    </button>

  </div>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(let list of alllistings) { %>
      <a href="/listings/<%= list._id %>" style="text-decoration: none;">
        <div class="card listing-card">
          <img src="<%= list.image.url %>" class="card-img-top" alt="card-image" style="height: 20rem;">
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b>
                <%= list.title %>
              </b><br>
              &#8377;<%= list.price.toLocaleString("en-IN") %> /night
            </p>
          </div>
        </div>
      </a>
      <% } %>
  </div>
  

  <script>

 

  </script>
