<% layout('layouts/boilerplate.ejs') %>

  <script>
    const mapToken = "<%= process.env.MAP_API_TOKEN %>";
    const listing = <%- JSON.stringify(Listing) %>;
    const coordinate = <%- JSON.stringify(Listing.geometry && Listing.geometry.coordinates ? Listing.geometry.coordinates : null) %>;
  </script>


  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h2 class="list-title">
        <%= Listing.title %>
      </h2>
    </div>
    <br />
    <div class="card col-6 offset-2 show-card listing-card">
      <div class="card-image">
        <img src="<%= Listing.image.url %>" class="card-img-top show-img" alt="listing_image" />
      </div>
      <br />

      <div class="card-body">
        <p class="card-title"><i>Owned by <%= Listing.owner.username %></i></p>
        <p class="card-title">
          <%= Listing.description %> <br />
        </p>

        <p class="card-title"> &#8377; <%= Listing.price %>/night <br /></p>
        <p class="card-title">
          <%= Listing.country %> <br />
        </p>
        <p class="card-title">
          <%= Listing.location %>
        </p> 
        <p class="card-title">
          <%= Listing.category %>
        </p> <br />
      </div>
    </div>
  </div>

  <% if(currUser && currUser._id.equals(Listing.owner._id)){ %>
    <div class="btns">
      <a href="/listings/<%= Listing._id %>/edit" class="btn btn-danger offset-2">Edit</a>
      <form method="post" action="/listings/<%=Listing._id %>?_method=delete">
        <button class="btn btn-secondary offset-4">Delete</button>
      </form>
    </div>
    <% } %>
      <hr />

      <!-- Review Section -->
      <% if(currUser){ %>
        <div class="col-8 offset-2 mb-5">
          <h3>Leave Review About Tour</h3>
          <form method="post" action="/listings/<%= Listing._id %>/reviews" novalidate class="needs-validation">

            <div>
              <label class="form-label">Rating</label>

              <fieldset class="starability-checkmark">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked
                  aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <div class="mb-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea cols="20" rows="6" name="review[comment]" id="comment" class="form-control" required></textarea>
            </div>
            <br>
            <button class="btn btn-secondary">Submit</button>

          </form>

          <hr />
        </div>
        <% } %>

          <!-- Review Show Section -->
          <% if(Listing.reviews && Listing.reviews.length> 0) { %>
            <div class="col-8 offset-2 mb-3">
              <h4>All Reviews</h4>
              <div class="row">
                <% for(review of Listing.reviews) { %>
                  <div class="card col-5 mb-3 ms-2">
                    <div class="card-body">
                      <h5 class="card-title">
                        &#64;<%= review.AuthorBy.username %><br />
                      </h5>
                      <p class="card-text">
                        <%= review.comment %>
                      </p>
                      <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                    </div>



                    <form method="post" action="/listings/<%=Listing._id %>/reviews/<%= review._id %>?_method=delete">
                      <button class="btn btn-ms btn-dark mb-3">Delete</button>
                    </form>
                  </div>
                  <% } %>
              </div>


            </div>
            <hr />
            <% } %>
              <!-- MAP IMPLEMENTATION -->
              <div class="col-8 offset-2 mb-5">
                <h2>Where you’ll be</h2>
                <div id="map">

                </div>
              </div>

              <% if(Listing.geometry && Listing.geometry.coordinates) { %>
                <script src="/js/map.js"></script>
                <% } else { %>
                  <div class="col-8 offset-2 mb-3 text-muted"><small>⚠️ Map not available: location coordinates could
                      not be found for this listing.</small></div>
                  <% } %>