<% layout('layouts/boilerplate.ejs') %>

  <br /><br />
  <div class="row">
    <div class="col-5 offset-3">
      <h2 class="mb-4">Edit your Listing</h2>
      <form method="POST" novalidate class="needs-validation" action="/listings/<%= Listing._id %>?_method=put"
        enctype="multipart/form-data">
        <div class="mb-3">
          <lable for="title" class="form-label">Title</lable><br />
          <input class="form-control" name="listing[title]" placeholder="Give your Journey title"
            value="<%= Listing.title %>" type="text" required />
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Description </label><br />
          <textarea class="form-control" name="listing[description]" placeholder="Share some detail about your place"
            rows="3" required>
<%= Listing.description %></textarea>
        </div>

        <!-- preview Image -->
        <div class="mb-3">
          Original Listing Image <br>
          <img alt="listing image" src=" <%= OriginalImageUrl %> " />
        </div>



        <!-- Add New Image -->
        <div class="mb-3">
          <label for="image" class="form-label">Upload New Image </label><br />
          <input class="form-control" name="listing[image]" type="file" />
        </div>

        <div class="row">
          <div class="mb-3 col-md-5">
            <label for="price" class="form-label">Price </label><br />
            <input class="form-control" name="listing[price]" placeholder="Enter price" value="<%= Listing.price %>"
              type="number" required />
          </div>
          <div class="mb-3 col-md-7">
            <label for="country" class="form-label">Country </label><br />
            <input class="form-control" name="listing[country]" placeholder="Enter country"
              value="<%= Listing.country %>" type="text" required />
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label">Location </label><br />
          <input class="form-control" name="listing[location]" placeholder="Enter location"
            value="<%= Listing.location %>" type="text" required />
        </div>

              
  <!-- Drop Down Menu -->

  <select class="form-select mb-3"  name="listing[category]">
    <option value="" selected disabled>Select an Action</option>
    <option value="Mountain">Mountain</option>
    <option value="Mountain-city">Mountain-city</option>
    <option value="Beach">Beach</option>
    <option value="Rooms">Rooms</option>
    <option value="Cafe">Cafe</option>
    <option value="Farms">Farms</option>
    <option value="Trending">Trending</option>
    <option value="Castles">Castles</option>
    <option value="Hiking">Hiking</option>
    <option value="Restaurants">Restaurants</option>
    <option value="Forest">Forest</option>
  </select>

        <br /><br />
        <button class="btn btn-secondary">Make Changes</button>
      </form>
      <br /><br />
    </div>
  </div>