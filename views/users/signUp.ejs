<% layout("layouts/boilerplate.ejs") %>


<div class="row mt-5">
  <div class="col-4 offset-3">
    <h2 class="mb-4 ms-6">SignUp For Marvel</h2>
    <form method="POST" action="/signup"   novalidate  class="needs-validation  ">
        
      <!--username-->
      <div class="mb-3">
        <label for="username" class="form-label" for="validationCustom01" class="form-label">UserName</label><br />
        <input
          class="form-control"
          name="username"
          id="username"
          type="text"
          required
        />
          <div class="valid-feedback"> Looks Good!</div>
          <div class="invalid-feedback"> Enter UserName</div>
    </div>

      <!--email-->
     <div class="mb-3">
        <label for="email" class="form-label" for="validationCustom01" class="form-label">Email</label><br />
        <input
          class="form-control"
          name="email"
          type="email"
          required
        />
        <div class="valid-feedback">Looks Good</div>
         <div class="invalid-feedback">Enter valid Email</div>
      </div>
      
      <!--password-->
     <div class="mb-3">
        <label for="password" class="form-label" for="validationCustom01" class="form-label">Password</label><br />
        <input
          class="form-control"
          name="password"
          type="password"
          required
        />
      </div>
      <button class="btn btn-danger">SignUp</button>


      </div>
      </div>